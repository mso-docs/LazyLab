# Export these values in the shell before starting SlothLab.
# .env files are not loaded automatically. No model is downloaded automatically.
OLLAMA_BASE_URL=http://localhost:11434
# Select an installed model from `ollama list` or browser model discovery.
OLLAMA_MODEL=

# Scientific memory, measured artifacts, and durable background-worker metadata.
SLOTHLAB_DB_PATH=artifacts/slothlab.sqlite
SLOTHLAB_ARTIFACT_DIR=artifacts
SLOTHLAB_JOB_DIR=artifacts/jobs
SLOTHLAB_LOG_LEVEL=INFO

# Additional execution settings belong in validated YAML or the browser form:
# inference_timeout_seconds: 300
# inference_context_tokens: 8192
# inference_threads: null       # null uses the inference runtime's default
# inference_thinking: null      # null / false / true; model must support overrides
# execution_isolation: auto     # auto / subprocess / bubblewrap
# Strict bubblewrap fails closed if namespaces are unavailable. Run `slothlab doctor`.

# Optional convenience profiles and JSON-only CLI research documents.
SLOTHLAB_PROFILE_DIR=artifacts/profiles
# SLOTHLAB_STORAGE_BACKEND=document  # default: sqlite; Guest selects document automatically
